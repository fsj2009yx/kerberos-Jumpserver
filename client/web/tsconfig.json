{
  "compilerOptions": {
    "target": "ES2021",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node", "electron"]
  },
  "include": [
    "main.ts",
    "preload.ts",
    "api/**/*.ts",
    "renderer/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
